# Auto-CRM / Flori Prospector — Variables de Entorno
# Copia este archivo como .env.local: cp .env.example .env.local

# =============================================================================
# OPCIONAL: API de Claude para clasificacion de leads con IA
# =============================================================================
# ANTHROPIC_API_KEY=sk-ant-...

# =============================================================================
# OPCIONAL: Email digest diario (registrate gratis en resend.com)
# =============================================================================
# RESEND_API_KEY=re_...
# DIGEST_EMAIL=tu@email.com
# DIGEST_FROM=Auto-CRM <onboarding@resend.dev>

# =============================================================================
# FLORI PROSPECTOR: Scraper local (worker.py)
# Secreto compartido entre el CRM y el scraper Python.
# Debe coincidir con CRM_SECRET en scraper/.env
# =============================================================================
N8N_CALLBACK_SECRET=flori-secret-change-me-in-production
SCRAPER_SECRET=flori-secret-change-me-in-production
