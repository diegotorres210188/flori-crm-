# Auto-CRM - Variables de Entorno
# Copia este archivo como .env.local: cp .env.example .env.local

# =============================================================================
# OPCIONAL: API de Claude para clasificacion de leads con IA
# Si no se configura, el CRM usa scoring basado en reglas (funciona igual de bien)
# =============================================================================
# ANTHROPIC_API_KEY=sk-ant-...

# =============================================================================
# OPCIONAL: Email digest diario (registrate gratis en resend.com)
# =============================================================================
# RESEND_API_KEY=re_...
# DIGEST_EMAIL=tu@email.com
# DIGEST_FROM=Auto-CRM <onboarding@resend.dev>

# =============================================================================
# FLORI PROSPECTOR: n8n Integration
# =============================================================================
# URL del webhook de n8n Cloud (o self-hosted). Se obtiene al activar el workflow.
# N8N_WEBHOOK_URL=https://your-instance.app.n8n.cloud/webhook/flori-prospector

# Secreto compartido para validar callbacks de n8n → Next.js
# N8N_CALLBACK_SECRET=your-random-secret-here

# URL publica de tu app (para que n8n pueda hacer callback). Usa ngrok en desarrollo.
# NEXT_PUBLIC_APP_URL=https://your-tunnel.ngrok-free.app
